=================== single thread, execution time 5.1s  ======================

#include <iostream>
 #include <thread>
 #include <mutex>
 #include <ctime>
 #include <windows.h>
 #include <vector>
 #include <bits/stdc++.h>

 
 std::vector<int> values;
 
 int main(){
 	for(int i = 0; i<100000000; i++){
 		values.push_back(rand()%10000);
	 }
 	int sum = std::accumulate(values.begin(), values.end(), 0);
 	std::cout << "average:" << sum / values.size() << std::endl;
 	int Sum = std::accumulate(values.begin(), values.end(), 0);
 	std::cout << "sum:" << Sum << std::endl;
 	int max = *std::max_element(values.begin(), values.end());
 	std::cout << "max:" << max << std::endl;
 	
 	return 0;
 }



======================== multi thread, execution time 3.8s ==========================



#include <iostream>
 #include <thread>
 #include <mutex>
 #include <ctime>
 #include <windows.h>
 #include <vector>
 #include <bits/stdc++.h>
int vectorSum;
int vectorAverage;
int vectorMaximum;
 std::mutex mtx; 
 std::vector<int> values;
 
 
 int avg(){
 	int sum = std::accumulate(values.begin(), values.end(), 0);
 	int average = sum / values.size();
 	mtx.lock();
 	vectorAverage = average;
 	mtx.unlock();
 }
 
 int sum(){
 	int Sum = std::accumulate(values.begin(), values.end(), 0);
 	mtx.lock();
 	vectorSum = Sum;
 	mtx.unlock();
 }
 
 int max(){
 	int maximum = *std::max_element(values.begin(), values.end());
 	mtx.lock();
 	vectorMaximum = maximum;
 	mtx.unlock();
 }
 int main(){
 	for(int i = 0; i<100000000; i++){
 		values.push_back(rand()%10000);
	 }
	std::thread S(sum);
	std::thread M(max);
	std::thread A(avg);
	
	S.join();
	M.join();
	A.join();


 	std::cout << "average:" << vectorAverage << std::endl;
 
 	std::cout << "sum:" << vectorSum  << std::endl;
 
 	std::cout << "max:" << vectorMaximum << std::endl;
 	
 	return 0;
 }
